APP_NAME=Diplomasi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# When true, mobile guest start + register + register-from-guest return 403 (see config/diplomasi.php).
DISABLE_APP_REGISTRATION=true

# Ø§Ù„ÙØ§ØªÙˆØ±Ø©: Ù„ÙˆØºÙˆ (Ø§Ø®ØªÙŠØ§Ø±ÙŠ). Ø¥Ù† Ù„Ù… ØªØ¶Ø¨Ø·Ù‡ ÙŠÙØ³ØªØ®Ø¯Ù… Ù…Ù„Ù Ø§Ù„Ù…Ø´Ø±ÙˆØ¹: public/images/logo.png
# INVOICE_LOGO_URL=https://your-domain.com/images/logo.png
# INVOICE_VAT_REGISTRATION_NUMBER=310000000000003

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: Auth (verification codes, OTP, account deletion) â€” from no-reply@
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@diplomasi.app
MAIL_PASSWORD=YOUR_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@diplomasi.app
MAIL_FROM_NAME="Diplomasi"

# Mail: Billing (invoices, subscriptions) â€” from billing@, same server/password
BILLING_MAIL_MAILER=smtp
BILLING_MAIL_HOST=smtp.office365.com
BILLING_MAIL_PORT=587
BILLING_MAIL_USERNAME=billing@diplomasi.app
BILLING_MAIL_PASSWORD=YOUR_PASSWORD
BILLING_MAIL_ENCRYPTION=tls
BILLING_MAIL_FROM_ADDRESS=billing@diplomasi.app
BILLING_MAIL_FROM_NAME="Diplomasi"
# Max verification charge to auto-refund (minor units): 100 = 1.00 USD with MOYASAR_CURRENCY=USD
BILLING_VERIFICATION_REFUND_MAX_MINOR=100

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MOYASAR_BASE_URL=https://api.moyasar.com/v1
# ISO 4217 — amount_minor uses cents for USD (same as Moyasar form docs).
MOYASAR_CURRENCY=USD
MOYASAR_WEBHOOK_EVENTS=payment_paid,payment_failed,payment_voided,payment_authorized,payment_captured,payment_refunded,payment_abandoned,payment_verified
# Default mode when DB setting billing.moyasar.mode is absent: test | live (aliases: production -> live)
MOYASAR_MODE=live

# --- Sandbox (test) ---
MOYASAR_TEST_PUBLIC_KEY=pk_test_xxxxx
MOYASAR_TEST_SECRET_KEY=sk_test_xxxxx
MOYASAR_TEST_WEBHOOK_SECRET_TOKEN=

# --- Production (live) ---
MOYASAR_LIVE_PUBLIC_KEY=pk_live_xxxxx
MOYASAR_LIVE_SECRET_KEY=sk_live_xxxxx
MOYASAR_LIVE_WEBHOOK_SECRET_TOKEN=

# Legacy single-key fallback (maps to test/live if MOYASAR_TEST_* / MOYASAR_LIVE_* omitted)
MOYASAR_PUBLIC_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET_TOKEN=

# Apple In-App Purchase (ØªØ­Ù‚Ù‚ Ø¥ÙŠØµØ§Ù„Ø§Øª iOS)
# Ù…Ù† App Store Connect: ØªØ·Ø¨ÙŠÙ‚Ùƒ > App Information > App-Specific Shared Secret
APPLE_IAP_SHARED_SECRET=
# DEV ONLY: set true to accept Xcode StoreKit local receipts
APPLE_IAP_ALLOW_XCODE_LOCAL=false

# ÙØªØ±Ø© Ø§Ù„Ø³Ù…Ø§Ø­ Ù„Ù„ØªØ¬Ø¯ÙŠØ¯ (Ø¯Ù‚Ø§Ø¦Ù‚) â€” ØªÙØ³ØªØ®Ø¯Ù… Ù…Ø¹ Moyasar Ùˆ Apple
# BILLING_RENEWAL_GRACE_MINUTES=15

VITE_APP_NAME="${APP_NAME}"

